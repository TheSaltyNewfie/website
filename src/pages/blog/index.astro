---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Divider from '../../components/Divider.astro';

const blogs = await getCollection("blog")
---

<Layout title="blogs">
    <div class="mx-auto md:w-fit w-[95vw]">
        <div class="my-4 rounded-lg bg-[#343232] p-4">
            <h1 class="text-center text-2xl">My Blogs</h1>
            <p>I am not much of a writer, but I figured why not try.<br/>Hope you find something here atleast interesting!</p>
        </div>

        <ul class="space-y-2 rounded-lg bg-[#343232] p-4">
            {blogs.map((blog) => (
                <li class="p-2 text-lg">
                    <a class="font-medium text-fg-brand underline hover:no-underline" href={`/blog/${blog.id}`}>{blog.data.title}</a>
                </li>
            ))}
        </ul>
    </div>
</Layout>
