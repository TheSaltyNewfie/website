---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogs = await getCollection("blog")
---

<Layout title="blogs">
    <div class="flex flex-col items-center">
        <ul>
            {blogs.map((index) => (
                <li class="text-2xl bg-[#343232] p-2 rounded-lg">
                    <a class="font-medium text-fg-brand hover:underline" href={`/blog/${index.id}`}>{index.data.title}</a>
                </li>
            ))}
        </ul>
    </div>
</Layout>
