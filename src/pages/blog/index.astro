---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogs = await getCollection("blog")
---

<Layout title="blogs">
    <div>
        <ul>
            {blogs.map((index) => (
                <li>
                    <a href={`/blog/${index.id}`}>{index.data.title}</a>
                </li>
            ))}
        </ul>
    </div>
</Layout>
