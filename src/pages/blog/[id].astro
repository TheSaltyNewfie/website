---
import { render } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { getEntry } from "astro:content"

export const prerender = false

const {id} = Astro.params

const blog = await getEntry("blog", id!)

if(!blog) {
    throw new Error("Entry not found")
}

const {Content} = await render(blog)
---
<Layout title=`${blog.data.title}`>
    <div class="flex flex-col w-full items-center justify-center">
        <div class="bg-[#343232] rounded-lg p-4 m-4 shadow-lg md:w-fit w-[95vw]">
            <h1 class="text-2xl mb-2">{blog.data.title}</h1>

            <article class="prose lg:prose-lg prose-invert max-w-none">
                <Content/>
            </article>
        </div>
    </div>
</Layout>