---
import '../styles/global.css';
import Message from '../components/Message.astro';
---

<html lang="en" class="bg-[#212020] text-[#ECEBE0]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tobias Dodge</title>
  </head>
  <body>
    <main class="min-h-screen flex flex-col h-full justify-center items-center">
      <div
        class="flex flex-col gap-2 flex-1 w-fit h-full justify-center items-center"
      >
        <div
          class="bg-[#343232] flex flex-col rounded-lg p-4 h-fit w-full items-start shadow-lg"
        >
          <div class="mb-6">
            <h1 class="text-2xl">Welcome to my website!</h1>
          </div>
          <div>
            <p>My name is Tobias, sometimes I make things.</p>
            <p>Eventually I'll do something with my website.</p>
          </div>
          <div class="mt-6 flex flex-row space-x-4">
            <p>
              <a
                href="https://github.com/TheSaltyNewfie"
                class="font-medium text-fg-brand hover:underline">Github</a
              >
            </p>
            <p>
              <a
                href="https://github.com/TheSaltyNewfie/website"
                class="font-medium text-fg-brand hover:underline">Source</a
              >
            </p>
          </div>
        </div>

        <Message />
      </div>
    </main>
  </body>
</html>
